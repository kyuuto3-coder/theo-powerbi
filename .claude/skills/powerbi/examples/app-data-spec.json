{
  "name": "AppStoreDashboard",
  "locale": "en-US",
  "autoDateTable": false,
  "tables": [
    {
      "name": "Apps",
      "file": "App Data.xlsx",
      "sheet": "Data",
      "headerRow": 1,
      "columns": [
        { "name": "id", "rename": "App ID", "type": "int64", "key": true, "hidden": true, "description": "App ID" },
        { "name": "track_name", "rename": "App Name", "type": "text", "description": "Track Name" },
        { "name": "size_bytes", "rename": "Size (Bytes)", "type": "int64", "format": "#,0", "description": "App Size in Bytes" },
        { "name": "price", "rename": "Price", "type": "decimal", "format": "$#,0.00", "description": "Price" },
        { "name": "rating_count_tot", "rename": "Rating Count", "type": "int64", "format": "#,0", "description": "Number of Rating" },
        { "name": "user_rating", "rename": "User Rating", "type": "double", "summarizeBy": "average", "format": "0.0", "description": "User Rating" },
        { "name": "prime_genre", "rename": "Genre", "type": "text", "description": "Prime Genre" },
        { "name": "sup_devices", "rename": "Supported Devices", "type": "int64", "description": "Number of Devices Supported" },
        { "name": "lang", "rename": "Supported Languages", "type": "int64", "description": "Number of Languages Supported" }
      ]
    }
  ],
  "measures": [
    { "table": "Apps", "name": "App Count", "dax": "COUNTROWS(Apps)", "format": "#,0" },
    { "table": "Apps", "name": "Avg Rating", "dax": "AVERAGE(Apps[User Rating])", "format": "0.00" },
    { "table": "Apps", "name": "Avg Price", "dax": "AVERAGE(Apps[Price])", "format": "$#,0.00" },
    { "table": "Apps", "name": "Free App %", "dax": "DIVIDE(CALCULATE(COUNTROWS(Apps), Apps[Price] = 0), COUNTROWS(Apps))", "format": "0.0%" },
    { "table": "Apps", "name": "Total Ratings", "dax": "SUM(Apps[Rating Count])", "format": "#,0" }
  ],
  "pages": [
    {
      "name": "Overview",
      "visuals": [
        { "type": "textbox", "text": "App Store Dashboard", "grid": [0, 0, 12, 1], "fontSize": 24 },
        { "type": "card", "title": "App Count", "fields": { "Values": ["Apps.App Count"] }, "grid": [0, 1, 3, 2] },
        { "type": "card", "title": "Avg Rating", "fields": { "Values": ["Apps.Avg Rating"] }, "grid": [3, 1, 3, 2] },
        { "type": "card", "title": "Avg Price", "fields": { "Values": ["Apps.Avg Price"] }, "grid": [6, 1, 3, 2] },
        { "type": "card", "title": "Free App %", "fields": { "Values": ["Apps.Free App %"] }, "grid": [9, 1, 3, 2] },
        { "type": "clusteredBarChart", "title": "App Count by Genre (Top 10)", "fields": { "Category": ["Apps.Genre"], "Y": ["Apps.App Count"] },
          "sort": { "field": "Apps.App Count", "direction": "desc" }, "topN": { "n": 10, "by": "Apps.App Count" }, "grid": [0, 3, 6, 5] },
        { "type": "clusteredColumnChart", "title": "Avg Rating by Genre", "fields": { "Category": ["Apps.Genre"], "Y": ["Apps.Avg Rating"] },
          "sort": { "field": "Apps.Avg Rating", "direction": "desc" }, "grid": [6, 3, 6, 3] },
        { "type": "slicer", "fields": { "Values": ["Apps.Genre"] }, "grid": [6, 6, 3, 2] },
        { "type": "scatterChart", "title": "Ratings vs Rating Count", "fields": { "Category": ["Apps.App Name"], "X": ["sum:Apps.Rating Count"], "Y": ["Apps.Avg Rating"], "Size": ["avg:Apps.Price"] }, "grid": [9, 6, 3, 2] }
      ]
    },
    {
      "name": "Details",
      "visuals": [
        { "type": "pivotTable", "title": "Summary by Genre", "fields": { "Rows": ["Apps.Genre"], "Values": ["Apps.App Count", "Apps.Avg Price", "Apps.Avg Rating", "Apps.Total Ratings"] }, "grid": [0, 0, 12, 4] },
        { "type": "donutChart", "title": "App Share by Genre", "fields": { "Category": ["Apps.Genre"], "Y": ["Apps.App Count"] }, "grid": [0, 4, 6, 4] },
        { "type": "tableEx", "title": "Top Apps by Ratings", "fields": { "Values": ["Apps.App Name", "Apps.Genre", "Apps.Price", "Apps.Total Ratings", "Apps.Avg Rating"] },
          "sort": { "field": "Apps.Total Ratings", "direction": "desc" }, "grid": [6, 4, 6, 4] }
      ]
    }
  ]
}
